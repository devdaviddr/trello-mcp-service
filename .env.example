# ---- Trello ----
# Get key + token at https://trello.com/power-ups/admin
# Click an existing Power-Up (or create one) → "API key" tab → copy the key.
# Then click the "Token" link in that page → authorize → copy the token.
TRELLO_API_KEY=your_trello_api_key_here
TRELLO_API_TOKEN=your_trello_api_token_here

# ---- Telegram ----
# Create a bot via @BotFather on Telegram → /newbot → paste the token here.
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Your numeric Telegram user ID (NOT username). Get it from @userinfobot.
# Comma-separate to allow multiple users (e.g. 123456789,987654321).
TELEGRAM_ALLOWED_USER_IDS=123456789

# ---- Ollama ----
# From inside Docker on Mac/Windows: http://host.docker.internal:11434
# From inside Docker on Linux:       http://172.17.0.1:11434 (or a LAN IP)
# Without Docker:                    http://localhost:11434
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3-coder:latest

# ---- MCP subprocess (advanced; defaults assume compiled build) ----
# For dev mode override to: MCP_SERVER_COMMAND=tsx and MCP_SERVER_ARGS=src/mcp-server/index.ts
MCP_SERVER_COMMAND=node
MCP_SERVER_ARGS=dist/mcp-server/index.js

# ---- Agent loop tuning (optional; defaults shown) ----
# MAX_TURNS=16                  # Max chained tool calls per user message
# TOOL_OUTPUT_CHAR_BUDGET=16000 # Tool output truncation before hitting LLM context
# OLLAMA_TIMEOUT_MS=120000      # Per-call abort timeout for Ollama
